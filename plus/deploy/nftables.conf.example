#!/usr/sbin/nft -f
# Host firewall example: default-drop inbound, SSH open, 80/443 only from Cloudflare (for a proxied site; a site served only via cloudflared needs neither).
# Only this table is (re)loaded (no "flush ruleset"), so tables that tailscaled (iptables-nft) and fail2ban manage stay intact.
table inet host {}
delete table inet host
table inet host {
	# Cloudflare edge ranges (https://www.cloudflare.com/ips/, fetched 2026-10-14)
	set cf4 { type ipv4_addr; flags interval; elements = { 173.245.48.0/20, 103.21.244.0/22, 103.22.200.0/22, 103.31.4.0/22, 141.101.64.0/18, 108.162.192.0/18, 190.93.240.0/20, 188.114.96.0/20, 197.234.240.0/22, 198.41.128.0/17, 162.158.0.0/15, 104.16.0.0/13, 104.24.0.0/14, 172.64.0.0/13, 131.0.72.0/22 } }
	set cf6 { type ipv6_addr; flags interval; elements = { 2400:cb00::/32, 2606:4700::/32, 2803:f800::/32, 2405:b500::/32, 2405:8100::/32, 2a06:98c0::/29, 2c0f:f248::/32 } }

	chain input {
		type filter hook input priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
		iif "lo" accept
		iifname "tailscale0" accept
		udp dport 41641 accept comment "tailscale direct"
		meta l4proto icmp accept
		meta l4proto ipv6-icmp accept
		tcp dport 22 accept comment "ssh (kept open)"
		tcp dport { 80, 443 } ip saddr @cf4 accept comment "exam site via Cloudflare proxy"
		tcp dport { 80, 443 } ip6 saddr @cf6 accept
	}

	chain output {
		type filter hook output priority filter; policy accept;
		# qq-music-api backend: only the al-accsrc service user may talk to it (LX scripts / other uids cannot)
		ip daddr 127.0.0.0/8 tcp dport 9411 meta skuid != "alaccsrc" reject with tcp reset
		ip6 daddr ::1 tcp dport 9411 meta skuid != "alaccsrc" reject with tcp reset
	}
}

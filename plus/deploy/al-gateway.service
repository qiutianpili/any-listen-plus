[Unit]
Description=Any Listen Plus gateway (Cloudflare Access -> per-user instances)
After=network-online.target
[Service]
WorkingDirectory=/opt/al-gateway
ExecStart=/usr/bin/node gw.js
Restart=always
RestartSec=3
MemoryMax=80M
# runs as root: it creates/removes the per-player system users (al-<id>) and starts/stops their units
PrivateTmp=true
ProtectHome=true
[Install]
WantedBy=multi-user.target
